{
  "name": "words",
  "version": "1.4.0",
  "description": "A word tile game based on Wonderful Word Weaving (http://wonderfulwordweaving.com/).",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "build:netlify": "vite build --mode netlify && node scripts/copy-netlify.mjs",
    "preview": "vite preview --port 3080",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test e2e playwright.config.js",
    "lint:fix": "eslint src test e2e playwright.config.js --fix",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:e2e": "playwright test",
    "coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/craigmcn/words.git"
  },
  "keywords": [
    "words",
    "word",
    "tiles",
    "game",
    "Wonderful",
    "Word",
    "Weaving"
  ],
  "author": "Craig McNaughton",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "tippy.js": "^6.3.7"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "packageManager": "yarn@4.14.1"
}
